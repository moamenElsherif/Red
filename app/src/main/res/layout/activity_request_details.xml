<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.graduation.red.presentation.home.request.RequestsModel" />

        <variable
            name="listener"
            type="com.graduation.red.presentation.home.request.requestdetails.RequestDetailsListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.home.request.requestdetails.RequestDetailsActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:padding="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:onClick="@{()->listener.onBack()}"
                android:padding="10dp"
                android:rotation="180"
                android:src="@drawable/arrow_orange"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/request_details"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/view15"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/bean_red"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout3" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toTopOf="@+id/cardView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view15">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView2"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                app:cardBackgroundColor="@color/bean_red"
                app:cardCornerRadius="100dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_blood_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@{item.requestedBloodType}"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="A+" />
            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/cardView2"
                app:layout_constraintStart_toEndOf="@+id/cardView2"
                app:layout_constraintTop_toTopOf="@+id/cardView2">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/user_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="3dp"
                    android:text="@{item.fullName()}"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Moamen Elsherif" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/wants_blood_for"
                    android:textAlignment="center"
                    android:textColor="@color/bean_red"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@+id/user_name"
                    app:layout_constraintStart_toEndOf="@+id/user_name"
                    app:layout_constraintTop_toTopOf="@+id/user_name" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/to_who"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@{item.getForWhoString()}"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView"
                    app:layout_constraintStart_toEndOf="@+id/appCompatTextView"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView"
                    tools:text="himself" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:paddingHorizontal="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dot1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot"
                    android:textColor="@color/bean_red"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView2"
                    app:layout_constraintStart_toEndOf="@+id/appCompatTextView2"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView2" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:singleLine="true"
                    android:text="@{item.verifiedPhoneNumber}"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/dot1"
                    app:layout_constraintStart_toEndOf="@+id/dot1"
                    app:layout_constraintTop_toTopOf="@+id/dot1"
                    tools:text="01112892080" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView2"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="7dp"
                    android:text="@string/mobile"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView3"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:padding="7dp"
                    android:text="@string/address"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@+id/appCompatTextView2"
                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextView2" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:singleLine="true"
                    android:text="@{item.donationAddress}"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/dot2"
                    app:layout_constraintStart_toEndOf="@+id/dot2"
                    app:layout_constraintTop_toTopOf="@+id/dot2"
                    tools:text="15, tahrir street London" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dot2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot"
                    android:textColor="@color/bean_red"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView3"
                    app:layout_constraintStart_toEndOf="@+id/appCompatTextView3"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView3" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView4"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:padding="7dp"
                    android:text="@string/message"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@+id/appCompatTextView3"
                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextView3" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="4"
                    android:text="@{item.messageToDonor}"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/dot3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/dot3"
                    app:layout_constraintTop_toTopOf="@+id/dot3"
                    tools:text="please come and donate becauseplease come and donate because" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dot3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot"
                    android:textColor="@color/bean_red"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView4"
                    app:layout_constraintStart_toEndOf="@+id/appCompatTextView4"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView4" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView6"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:padding="7dp"
                    android:text="@string/request_date"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@+id/appCompatTextView4"
                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextView4" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dot4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot"
                    android:textColor="@color/bean_red"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView6"
                    app:layout_constraintStart_toEndOf="@+id/appCompatTextView6"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView6" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="4"
                    android:text="@{item.date}"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/dot4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/dot4"
                    app:layout_constraintTop_toTopOf="@+id/dot4"
                    tools:text="10/10/2010" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView7"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:padding="7dp"
                    android:text="@string/donors_count"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@+id/appCompatTextView6"
                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextView6" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dot5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot"
                    android:textColor="@color/bean_red"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView7"
                    app:layout_constraintStart_toEndOf="@+id/appCompatTextView7"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView7" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="4"
                    android:text="@{item.donorsCount()}"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/dot5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/dot5"
                    app:layout_constraintTop_toTopOf="@+id/dot5"
                    tools:text="5" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView8"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:padding="7dp"
                    android:text="@string/gender"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@+id/appCompatTextView7"
                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextView7" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dot6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot"
                    android:textColor="@color/bean_red"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView8"
                    app:layout_constraintStart_toEndOf="@+id/appCompatTextView8"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView8" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView9"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="4"
                    android:text="@{item.getUserGender()}"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/dot6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/dot6"
                    app:layout_constraintTop_toTopOf="@+id/dot6"
                    tools:text="male" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView5"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:padding="7dp"
                    android:text="@string/map_location"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@+id/appCompatTextView8"
                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextView8" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dot9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot"
                    android:textColor="@color/bean_red"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView5"
                    app:layout_constraintStart_toEndOf="@+id/appCompatTextView5"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView5" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="3"
                    android:text="@{item.locationAddress}"
                    android:textColor="@color/black"
                    android:textAlignment="viewStart"
                    app:layout_constraintBottom_toBottomOf="@+id/dot9"
                    app:layout_constraintEnd_toStartOf="@+id/imageView"
                    app:layout_constraintStart_toEndOf="@+id/dot9"
                    app:layout_constraintTop_toTopOf="@+id/dot9"
                    tools:text="please come and donate becauseplease come and donate because" />

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/location"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView5" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/appCompatTextView15"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:padding="7dp"
                    android:text="@string/request_status"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@+id/appCompatTextView5"
                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextView5" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dot15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot"
                    android:textColor="@color/bean_red"
                    app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView15"
                    app:layout_constraintStart_toEndOf="@+id/appCompatTextView15"
                    app:layout_constraintTop_toTopOf="@+id/appCompatTextView15" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="4"
                    android:text="@{item.getRequestStatus()}"
                    android:textColor="@{item.getRequestStatusColor()}"
                    app:layout_constraintBottom_toBottomOf="@+id/dot15"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/dot15"
                    app:layout_constraintTop_toTopOf="@+id/dot15"
                    tools:text="New" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/view16"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_margin="20dp"
                android:background="@color/bean_red"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout2" />


            <TextView
                android:id="@+id/textView6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="15dp"
                android:text="@string/donation_text"
                android:textStyle="italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view16" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/thank_you"
                android:textColor="@color/bean_red"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView6" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_donate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bean_red"
                android:onClick="@{()->listener.onSubmit()}"
                android:text="@string/donate"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>